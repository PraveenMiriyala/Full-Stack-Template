# Database Connection (Application Data - Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=public"

# Payload CMS Database Connection (Isolated Schema or Database)
PAYLOAD_DATABASE_URI="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=payload"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Payload CMS Configuration
PAYLOAD_SECRET="your-payload-cms-secret-key-at-least-32-characters-long"

# Next.js Draft Preview Secret
PREVIEW_SECRET="your-preview-secret-key-at-least-32-characters-long"

# CMS Initial Admin Credentials (Required for seeding)
CMS_ADMIN_EMAIL="admin@example.com"
CMS_ADMIN_PASSWORD="YourSecurePassword123!"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
