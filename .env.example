# Database Connection (Replace 'my_app_db' with your project database name)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_app_db?schema=public"

# Better Auth Secret (Generate a unique key of at least 32 characters: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
